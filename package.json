{
  "name": "layerflow-web",
  "version": "1.0.0",
  "private": true,
  "description": "LayerFlow — the production infrastructure platform for AI applications.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c cyan,magenta,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:worker\"",
    "dev:web": "next dev",
    "dev:api": "npm run dev --workspace @layerflow/api",
    "dev:worker": "npm run worker --workspace @layerflow/api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:prod": "bash scripts/check-production.sh",
    "deploy:api": "bash scripts/deploy-api-prod.sh"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@layerflow/contracts": "*",
    "better-auth": "^1.6.23",
    "framer-motion": "^11.15.0",
    "geist": "^1.7.2",
    "next": "^16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.2.4",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.10",
    "happy-dom": "^18.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
