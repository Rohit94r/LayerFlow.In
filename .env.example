# LayerFlow frontend (Next.js)
#
# Copy to `.env.local` for local development. Never commit real secrets.

# Hono API origin (Better Auth + workspace REST). Include scheme, no trailing slash.
# Local:  http://localhost:8787
# Prod:   https://api.layerflow.dev
# Use 127.0.0.1 (not localhost) — avoids IPv6 ::1 fetch failures in browsers.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
