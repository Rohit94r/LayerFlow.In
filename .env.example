# Local frontend — gitignored
NEXT_PUBLIC_API_URL=http://localhost:8787

# ── Also set these in Vercel → Project → Environment Variables (Production) ──
# Required for same-origin sign-in on layerflow.dev (until api.layerflow.dev is live):
#
# DATABASE_URL=postgresql://...
# REDIS_URL=rediss://...
# BETTER_AUTH_SECRET=<openssl rand -hex 32>
# BETTER_AUTH_URL=https://layerflow.dev
# WEB_URL=https://layerflow.dev
# API_URL=https://api.layerflow.dev
# CORS_ORIGINS=https://layerflow.dev
# PROVIDER_KEYS_KEK=<64 hex chars>
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
#
# Google OAuth redirect URI (add in Google Cloud Console):
#   https://layerflow.dev/api/auth/callback/google
