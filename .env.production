# ── LayerFlow Production Environment (2GB VPS) ────────────────────────────────
# Copy this to .env and fill secrets.
# cp .env.production .env && nano .env

# ── REQUIRED: Database ────────────────────────────────────────────────────────
# Option A: Use Neon (free) - https://neon.tech
# DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Option B: Local Postgres (uses ~256MB RAM)
DATABASE_URL=postgres://layerflow:${POSTGRES_PASSWORD}@postgres:5432/layerflow

# ── REQUIRED: Redis ───────────────────────────────────────────────────────────
# Option A: Use Upstash (free) - https://upstash.com
# REDIS_URL=redis://default:pass@xxxx.upstash.io:6379
# Option B: Local Redis (uses ~64MB RAM)
REDIS_URL=redis://redis:6379

# ── REQUIRED: Auth ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
BETTER_AUTH_URL=https://api.layerflow.dev

# ── REQUIRED: Encryption ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
PROVIDER_KEYS_KEK=change-me-openssl-rand-hex-32

# ── URLs / CORS ───────────────────────────────────────────────────────────────
WEB_URL=https://layerflow.dev
API_URL=https://api.layerflow.dev
CORS_ORIGINS=https://layerflow.dev

# ── OPTIONAL: Google OAuth ────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# ── OPTIONAL: Platform AI Keys (at least one for chat to work) ────────────────
# GROQ is free and works out of the box: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# OPENAI_API_KEY=sk-proj-xxx
# GEMINI_API_KEY=xxx
# DEEPSEEK_API_KEY=xxx

# ── OPTIONAL: Monitoring ──────────────────────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx

# ── OPTIONAL: Email ───────────────────────────────────────────────────────────
# RESEND_API_KEY=re_xxx

# ── OPTIONAL: File Storage (R2) ───────────────────────────────────────────────
# R2_ACCOUNT_ID=xxx
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_BUCKET=layerflow-uploads

# ── OPTIONAL: Billing (Dodo Payments) ─────────────────────────────────────────
# DODO_API_KEY=xxx
# DODO_WEBHOOK_SECRET=xxx
