# Local frontend — gitignored
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional: comma-separated admin emails for UI gating (defaults to rjdhav67@gmail.com).
# Server enforcement uses ADMIN_EMAILS on the API (same default).
# NEXT_PUBLIC_ADMIN_EMAILS=rjdhav67@gmail.com

# Optional (server-side only, never exposed to the browser): used by the Vercel
# health proxy + admin analytics to reach the API when it is NOT same-origin yet
# (e.g. https://api.layerflow.dev or https://layerflow-api.fly.dev). When unset
# they fall back to WEB_URL same-origin.
# API_INTERNAL_URL=https://layerflow.dev

# ── Also set these in Vercel → Project → Environment Variables (Production) ──
# Required for same-origin auth + workspace API on layerflow.dev
# (Hono is mounted under Next `/api/*` and `/v1/*` until api.layerflow.dev is live):
#
# DATABASE_URL=postgresql://...
# REDIS_URL=rediss://...
# BETTER_AUTH_SECRET=<openssl rand -hex 32>
# BETTER_AUTH_URL=https://layerflow.dev
# WEB_URL=https://layerflow.dev
# API_URL=https://layerflow.dev
# CORS_ORIGINS=https://layerflow.dev
# PROVIDER_KEYS_KEK=<64 hex chars>
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# ADMIN_EMAILS=rjdhav67@gmail.com
# NEXT_PUBLIC_API_URL is optional on Vercel — the browser uses same-origin.
#
# Google OAuth redirect URI (add in Google Cloud Console):
#   https://layerflow.dev/api/auth/callback/google
