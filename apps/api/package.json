{
  "name": "@layerflow/api",
  "version": "0.1.0",
  "private": true,
  "description": "LayerFlow backend — Hono API + BullMQ worker.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "worker": "tsx watch src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "usage:rollup": "tsx scripts/usage-rollup.ts",
    "usage:reconcile": "tsx scripts/reconcile.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@hono/node-server": "^2.0.10",
    "@layerflow/contracts": "*",
    "@layerflow/model-registry": "*",
    "@sentry/node": "^10.66.0",
    "better-auth": "^1.6.23",
    "bullmq": "^5.80.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.10",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
