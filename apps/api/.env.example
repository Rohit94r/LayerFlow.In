# ── Required — the API refuses to start without these ────────────────────────
# Postgres connection (docker compose default shown)
DATABASE_URL=postgres://layerflow:layerflow@localhost:5432/layerflow

# Better Auth: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Public URL of THIS API service (Better Auth builds callback URLs from it)
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth client (see README for exact console steps)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Redis connection (docker compose default shown; Upstash URL in production)
REDIS_URL=redis://localhost:6379

# Key-encryption-key for BYOK provider keys (AES-256-GCM) and API-key HMAC.
# Generate with `openssl rand -hex 32` — must be 64 hex chars.
PROVIDER_KEYS_KEK=change-me-generate-with-openssl-rand-hex-32

# URLs / CORS
WEB_URL=http://localhost:3000
API_URL=http://localhost:8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────
# API port (defaults to 8787)
# PORT=8787

# OpenAI (semantic search embeddings) — leave unset to use the local
# deterministic fallback embedding (see apps/api/src/search/README.md)
# OPENAI_API_KEY=sk-...

# Stripe (billing) — leave unset for local dev
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email) — leave unset for local dev
# RESEND_API_KEY=re_...

# Sentry (errors) — leave unset for local dev
# SENTRY_DSN=https://...@sentry.io/...

# Cloudflare R2 (file storage) — leave unset for local dev
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
