# ── Required — the API refuses to start without these ────────────────────────
# Postgres connection — Neon URI for cloud, or docker compose default for local:
# DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
DATABASE_URL=postgres://layerflow:layerflow@localhost:5432/layerflow
# Never run `npm run db:seed` against Neon production (see docs/database.md).

# Better Auth: generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
# Public URL of THIS API service (Better Auth builds callback URLs from it)
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth — optional; email/password auth works without it.
# To enable Google sign-in, create credentials at console.cloud.google.com
# and set the redirect URI to {BETTER_AUTH_URL}/api/auth/callback/google
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# Redis connection (docker compose default shown; Upstash URL in production)
REDIS_URL=redis://localhost:6379

# Key-encryption-key for BYOK provider keys (AES-256-GCM) and API-key HMAC.
# Generate with `openssl rand -hex 32` — must be 64 hex chars.
PROVIDER_KEYS_KEK=change-me-generate-with-openssl-rand-hex-32

# URLs / CORS
WEB_URL=http://localhost:3000
API_URL=http://localhost:8787
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Production URLs (set in your API host dashboard) ─────────────────────────
# Full beginner guide: docs/production-env.md
#
# WEB_URL=https://layerflow.dev
# API_URL=https://api.layerflow.dev
# BETTER_AUTH_URL=https://api.layerflow.dev
# CORS_ORIGINS=https://layerflow.dev
#
# Google OAuth production redirect:
#   https://api.layerflow.dev/api/auth/callback/google
#
# Do NOT use a *.vercel.app URL in these variables.
# Leave Stripe unset — payments are disabled on the pricing page.

# ── Optional ──────────────────────────────────────────────────────────────────
# API port (defaults to 8787)
# PORT=8787

# OpenAI (semantic search embeddings) — leave unset to use the local
# deterministic fallback embedding (see apps/api/src/search/README.md)
# OPENAI_API_KEY=sk-...

# Platform provider keys — used when a workspace has no BYOK key for that
# provider, so model runs / compare / gateway work out of the box.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_API_KEY=sk-...
# KIMI_MODEL=kimi-k2
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-3-mini

# ElevenLabs — reserved for future audio / sound-effect features.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Stripe (billing) — leave unset for local dev
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Dodo Payments (billing) — create an account at app.dodopayments.com, then:
#   1. Create a product per plan (Starter $5/mo, Pro $14/mo) in Products.
#   2. Developer → API → Add API key (write access) → paste below.
#   3. Developer → Webhooks → add {API_URL}/api/billing/webhook → copy secret below.
# API key from Developer → API (this is the project's live key — rotate if shared)
DODO_PAYMENTS_API_KEY=NRMa1Yf8tYNe3u4T.RT942znqQF1bZ7XDiU4MVcpF9qLaSF1Y-ZDwlvlDYfS2ACLK
# Webhook signing secret (from Developer → Webhooks) — required in production
DODO_PAYMENTS_WEBHOOK_KEY=whsec_S+keekv/JPE3QV2Mbw3hY6ozzDxYlu5s
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# "test_mode" (default) or "live_mode" — this key is live-only
DODO_PAYMENTS_ENVIRONMENT=live_mode
# Where the customer lands after checkout (defaults to {WEB_URL}/billing)
# DODO_PAYMENTS_RETURN_URL=https://layerflow.dev/billing
# Billing currency (ISO 4217, defaults to USD)
# DODO_BILLING_CURRENCY=USD
# Product ids created in the dashboard (Products → Add Product):
DODO_PRODUCT_STARTER=pdt_0NkpNaGX4CegvGbwXDpcQ
DODO_PRODUCT_PRO=pdt_0NkpNb3CNkeG8jI1bIJaM
# DODO_PRODUCT_TEAM=

# Resend (email: budget alerts + weekly digests) — leave unset for local dev
# (without a key the email service logs a safe no-op)
# RESEND_API_KEY=re_...
# FROM_EMAIL=LayerFlow <alerts@layerflow.dev>

# Sentry (errors) — leave unset for local dev
# SENTRY_DSN=https://...@sentry.io/...
# Trace sampling 0..1 (defaults: 0.1 in production, 0 elsewhere)
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Session cookie domain for cross-subdomain auth in production.
# Derived automatically from WEB_URL/API_URL (.layerflow.dev); set to override.
# COOKIE_DOMAIN=.layerflow.dev
#
# Session TTL is configured in code (apps/api/src/auth/config.ts), not env:
#   expiresIn = 30 days, updateAge = 1 day (sliding), cookieCache maxAge = 5 min.
# Cookies use maxAge (persist across browser restarts). Secure only when
# NODE_ENV=production (HTTPS). Local http uses non-Secure host-only cookies.

# Admin analytics allowlist (comma-separated, case-insensitive).
# Defaults to rjdhav67@gmail.com when unset.
# ADMIN_EMAILS=rjdhav67@gmail.com

# Cloudflare R2 (file storage) — leave unset for local dev
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# ── Token / cost saver (optional; workspace Prefer-cheap / Token saver also apply) ──
# Soft input token budget before history truncation (default 6000)
# TOKEN_SAVER_INPUT_BUDGET=6000
# Keep last N non-system messages full when truncating (default 4)
# TOKEN_SAVER_KEEP_TURNS=4
# max_tokens when Prefer-cheap or Token saver is on (default 512)
# TOKEN_SAVER_MAX_TOKENS=512
# Exact-match Redis cache TTL in seconds (default 3600)
# EXACT_CACHE_TTL_SECONDS=3600
# Optional LLM summarization of older turns (default false — deterministic truncate)
# TOKEN_SAVER_SUMMARY=false
